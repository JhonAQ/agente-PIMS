# ============================================================
# Agente PIMS — Variables de entorno
# Copia este archivo a .env.local y completa los valores
# ============================================================

# Google Gemini API Key (obtener en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de Gemini a utilizar
GEMINI_MODEL=gemini-2.0-flash

# Activar el contexto de la UNSA (true | false)
# false = modo auditor general de PIMS / Ley 29733
# true  = modo auditor UNSA (carga resoluciones institucionales)
ENABLE_UNSA_CONTEXT=false

# Puerto del servidor Next.js (por defecto 3000)
PORT=3000
