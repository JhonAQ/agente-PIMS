# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Environments
.env
.env*.local
.venv
env/
venv/
ENV/

# Node.js & Next.js
node_modules/
.next/
out/
pnpm-debug.log*

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db

# Typst cache/temporary files
.typst-cache/

# Raw PDFs, HTML & Large binary knowledge files
knowledge/**/raw_pdfs/*
!knowledge/**/raw_pdfs/.gitkeep
knowledge/**/raw_html/*
!knowledge/**/raw_html/.gitkeep
